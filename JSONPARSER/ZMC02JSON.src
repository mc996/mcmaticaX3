################################################################################
#
# Parser JSON standalone ed event driven (SAX-like).
#
# Scansiona un documento JSON carattere per carattere ed espone una serie di
# eventi al programma handler passato come parametro. L'handler riceve gli
# eventi tramite la label $YPARSING (Gosub YPARSING From =PEVENTHANDLER).
#
# Eventi generati (variabile YEVENT):
#   BEGIN_PARSING : inizio analisi documento
#   END_ELEMENT   : chiusura di un elemento/value (con valore estratto)
#   END_PARSING   : fine analisi documento
#
# Variabili di contesto disponibili nell'handler a ogni evento:
#   PURI     array di Char, percorso dell'albero dal root al nodo corrente
#   PELEMENT Char, nome dell'elemento corrente
#   PVALUE   Char, valore estratto (solo END_ELEMENT)
#   PCOUNT   Integer, contatore occorrenze del percorso (1,2,3...)
#   PSTOP    Integer, se impostato a [V]CST_AYES dall'handler interrompe il parse
#
# L'URI percorsale NON include l'indice degli array: i nodi ripetuti di uno
# stesso oggetto in un array condividono lo stesso percorso e si distinguono
# tramite il contatore PCOUNT. Es.: positions>supplier_item_number con
# PCOUNT 1,2,3...
#
################################################################################

#**
#* max sublevels (profondita) dell'albero gestita
#*!
Funprog F_DEEPLEVEL()
End 15

#**
#* max numeri di percorsi (combinazioni albero) gestiti
#*!
Funprog F_MAXELEMENT()
End 200


#**
#* Parser JSON da file: legge l'intero file in un Clbfile e chiama il core
#*
#* @param PPATH          - percorso del file JSON da leggere
#* @param PEVENTHANDLER  - nome del sorgente che gestisce gli eventi ($YPARSING)
#* @param PPROGRESS      - CST_AYES -> mostra progress, CST_ANO -> no
#* @param WERRMSG        - messaggi di errore in uscita
#*!
Subprog S_PARSE_JSON_FILE(PPATH, PEVENTHANDLER, PPROGRESS, WERRMSG)
Value Char PPATH
Value Char PEVENTHANDLER
Value Integer PPROGRESS
Variable Char WERRMSG

  Local Clbfile YDOC(14)

  Raz WERRMSG

  Openi PPATH Using [FJSON3]

  Iomode adxirs ""  Using [FJSON3]
  Iomode adxifs ""  Using [FJSON3]
  Iomode adxium 50  Using [FJSON3]

  Local Integer YCONTA : YCONTA = 0

  Repeat
    Rdseq YDOC Using [FJSON3]        # carica l'intero file nel clob
    YCONTA += 1
  Until fstat <> 0
  Openi Using [FJSON3]

  If YCONTA > 1 Then
    WERRMSG = "File troppo grande (righe:" + num$(YCONTA) + ")"
  Else
    # rimuove CR/LF sostituendoli con spazio
    YDOC = ctrans(YDOC, chr$(10), " ")
    YDOC = ctrans(YDOC, chr$(13), " ")

    Call S_PARSE_JSON_CLB(YDOC, PEVENTHANDLER, PPROGRESS, WERRMSG)
  Endif

End


#**
#* Parser JSON da Clbfile gia in memoria
#*
#* @param PDOC           - documento JSON in ingresso (Clbfile)
#* @param PEVENTHANDLER  - nome del sorgente che gestisce gli eventi ($YPARSING)
#* @param PPROGRESS      - CST_AYES -> mostra progress, CST_ANO -> no
#* @param WERRMSG        - messaggi di errore in uscita
#*!
Subprog S_PARSE_JSON_CLB(PDOC, PEVENTHANDLER, PPROGRESS, WERRMSG)
Value Clbfile PDOC
Value Char PEVENTHANDLER
Value Integer PPROGRESS
Variable Char WERRMSG

  Local Char YELEMENTTREE(250)(0..func F_DEEPLEVEL())
  Local Char YELECOUNTER(250)(func F_MAXELEMENT(), func F_DEEPLEVEL() + 1)

  Call JSONPARSE(PDOC, PEVENTHANDLER, PPROGRESS, YELEMENTTREE, YELECOUNTER, WERRMSG)

End


#**
#* Core del parser: macchina a stati che scandisce il documento carattere per
#* carattere e genera gli eventi verso l'handler.
#*
#* @param YDOC           - documento JSON in ingresso (Clbfile)
#* @param PEVENTHANDLER  - nome del sorgente handler degli eventi
#* @param PPROGRESS      - CST_AYES -> mostra progress, CST_ANO -> no
#* @param YELEMENTTREE   - albero (percorso) corrente dei nodi
#* @param YELECOUNTER    - contatore occorrenze percorsi
#* @param WERRMSG        - messaggi di errore in uscita
#*!
Subprog JSONPARSE(YDOC, PEVENTHANDLER, PPROGRESS, YELEMENTTREE, YELECOUNTER, WERRMSG)
Variable Clbfile YDOC
Value Char PEVENTHANDLER
Value Integer PPROGRESS
Variable Char YELEMENTTREE
Variable Char YELECOUNTER
Variable Char WERRMSG
  Local Integer I, J
  Local Char YCH(1)
  Local Integer YCOUNT
  Local Integer PSTOP

  Local Integer YSTATE              # 0=atteso key/}, 1=key ok atteso :, 2=atteso value, 3=atteso strutturale
  Local Integer YPKEY               # flag: la chiave corrente e in attesa di valore (container nominato)
  Local Integer YNBR                # contatore dei frame (stack) aperti
  Local Char YFR(1)(0..func F_DEEPLEVEL(),3)   # stack frame: (0)=tipo O/A, (1)=named, (2)=depth
  Local Char YCURRNAME(120)
  Local Clbfile YCURRVAL(1)

  Local Integer INTERRUPT

  Raz YSTATE
  Raz YPKEY
  Raz YNBR
  Raz YFR
  Raz YCURRNAME
  Raz YCURRVAL

  If PPROGRESS = [V]CST_AYES Then
    Call OUVRE_BOITE("JSON Parsing ", len(YDOC)) From GESECRAN
    Call SET_BOITE("JSON Parsing", len(YDOC)) From GESECRAN
  Endif

  # inizio del parsing
  Local Char YEVENT(20) : YEVENT = "START_PARSING"
  Gosub YPARSING From =PEVENTHANDLER
  If PSTOP = [V]CST_AYES Then Goto $EXIT_JSONPARSE : Endif

  I = 0
  While I < len(YDOC)
    YCH = mid$(YDOC,I,1)

    If YCH = " " or YCH = chr$(9) or YCH = chr$(10) or YCH = chr$(13) Then
      I += 1
      Goto CONTINUE

    Elsif YCH = "{" Then
      # apertura oggetto: frame nominato se e il valore di una chiave
      Call OPEN_CONTAINER(YELEMENTTREE, YFR, YNBR, "O", YPKEY)
      YSTATE = 0
      Raz YPKEY

    Elsif YCH = "}" Then
      # chiusura oggetto
      Call CLOSE_CONTAINER(YELEMENTTREE, YFR, YNBR)
      YSTATE = 3

    Elsif YCH = "[" Then
      # apertura array: frame nominato se e il valore di una chiave
      Call OPEN_CONTAINER(YELEMENTTREE, YFR, YNBR, "A", YPKEY)
      YSTATE = 2
      Raz YPKEY

    Elsif YCH = "]" Then
      # chiusura array
      Call CLOSE_CONTAINER(YELEMENTTREE, YFR, YNBR)
      YSTATE = 3

    Elsif YCH = ":" Then
      # dopo una chiave : il prossimo token e un valore
      YSTATE = 2

    Elsif YCH = "," Then
      # separatore: in un oggetto attende la chiave, in un array un elemento
      If YNBR > 0 and YFR(YNBR,0) = "O" Then
        YSTATE = 0
      Else
        YSTATE = 2
      Endif

    Elsif YCH = '"' Then
      # stringa: chiave (state 0) o valore (state 2)
      If YSTATE = 0 Then
        Call S_READ_STRING(YDOC, I, YCURRNAME, J)
        If J > 0 Then
          YCURRNAME = vireblc(YCURRNAME,2)
          Call APPEND_TO_TREEELEMENT(YELEMENTTREE, YELECOUNTER, YCURRNAME, YCOUNT)
          YSTATE = 1
          YPKEY = 1
          I = J
        Endif
      Else
        Call S_READ_STRING(YDOC, I, YCURRVAL, J)
        If J > 0 Then
          YSTATE = 3
          If func F_DEPTH(YELEMENTTREE) > 0 Then
            Call EMIT_END(PEVENTHANDLER, YELEMENTTREE, YELECOUNTER, func F_TOPELEM(YELEMENTTREE), YCURRVAL, YCOUNT, PSTOP, WERRMSG)
            If PSTOP = [V]CST_AYES Then Goto $EXIT_JSONPARSE : Endif
            If YPKEY = 1 Then
              Call REMOVE_LAST_TREEELEMENT(YELEMENTTREE)
            Endif
          Endif
          Raz YPKEY
          I = J
        Endif
      Endif

    Else
      # token non quotato (numero / true / false / null)
      J = I
      While J < len(YDOC) and mid$(YDOC,J,1) <> "," and mid$(YDOC,J,1) <> "}" and mid$(YDOC,J,1) <> "]" and
&           mid$(YDOC,J,1) <> ":" and mid$(YDOC,J,1) <> "{" and mid$(YDOC,J,1) <> "[" and
&           mid$(YDOC,J,1) <> '"' and mid$(YDOC,J,1) <> " " and mid$(YDOC,J,1) <> chr$(9) and
&           mid$(YDOC,J,1) <> chr$(10) and mid$(YDOC,J,1) <> chr$(13)
        J += 1
      Wend
      If func F_DEPTH(YELEMENTTREE) > 0 Then
        YCURRVAL = mid$(YDOC, I, J-I)
        Call EMIT_END(PEVENTHANDLER, YELEMENTTREE, YELECOUNTER, func F_TOPELEM(YELEMENTTREE), YCURRVAL, YCOUNT, PSTOP, WERRMSG)
        If PSTOP = [V]CST_AYES Then Goto $EXIT_JSONPARSE : Endif
        If YPKEY = 1 Then
          Call REMOVE_LAST_TREEELEMENT(YELEMENTTREE)
        Endif
        YSTATE = 3
        Raz YPKEY
        I = J
       Goto CONTINUE
      Endif
    Endif

    I += 1

    If PPROGRESS = [V]CST_AYES Then
      Call AFF_BOITE("Element: " - YCURRNAME, I, INTERRUPT) From GESECRAN
    Endif
    If INTERRUPT = 1 Then Break : Endif
$CONTINUE
  Wend

$EXIT_JSONPARSE
  If PPROGRESS = [V]CST_AYES Then
    Call FERME_BOITE From GESECRAN
  Endif

  Local Char YEVENT(20) : YEVENT = "END_PARSING"
  Gosub YPARSING From =PEVENTHANDLER

End


#**
#* Apre un contenitore (oggetto o array) salvando uno stack frame.
#*
#* @param YELEMENTTREE  - albero (percorso) dei nodi
#* @param YFR           - stack dei frame [tipo, named, depth]
#* @param YNBR          - contatore frame (in/out)
#* @param PTYPE         - "O" oggetto / "A" array
#* @param PNAMED        - 1 se il contenitore e il valore di una chiave
#*!
Subprog OPEN_CONTAINER(YELEMENTTREE, YFR, YNBR, PTYPE, PNAMED)
Variable Char YELEMENTTREE
Variable Char YFR
Variable Integer YNBR
Value Char PTYPE
Value Integer PNAMED

  YNBR += 1
  YFR(YNBR,0) = PTYPE
  YFR(YNBR,1) = num$(PNAMED)
  YFR(YNBR,2) = num$(func F_DEPTH(YELEMENTTREE))

End


#**
#* Chiude un contenitore ripristinando l'albero alla profondita del frame.
#*
#* @param YELEMENTTREE  - albero (percorso) dei nodi
#* @param YFR           - stack dei frame
#* @param YNBR          - contatore frame (in/out)
#*!
Subprog CLOSE_CONTAINER(YELEMENTTREE, YFR, YNBR)
Variable Char YELEMENTTREE
Variable Char YFR
Variable Integer YNBR

  Local Integer YNAMED : YNAMED = val(YFR(YNBR,1))
  Local Integer YDEPTH : YDEPTH = val(YFR(YNBR,2))

  While func F_DEPTH(YELEMENTTREE) > YDEPTH
    Call REMOVE_LAST_TREEELEMENT(YELEMENTTREE)
  Wend

  If YNAMED = 1 Then
    Call REMOVE_LAST_TREEELEMENT(YELEMENTTREE)
  Endif

  YNBR -= 1

End


#**
#* Ritorna il numero di nodi popolati dell'albero (profondita)
#*
#* @param WELEMENTTREE  - albero dei nodi
#*!
Funprog F_DEPTH(WELEMENTTREE)
Value Char WELEMENTTREE

  Local Integer RESULT
  While WELEMENTTREE(RESULT) <> ""
    RESULT += 1
  Wend

End RESULT


#**
#* Ritorna il nome dell'elemento in cima all'albero (o "")
#*
#* @param WELEMENTTREE  - albero dei nodi
#*!
Funprog F_TOPELEM(WELEMENTTREE)
Value Char WELEMENTTREE

  Local Integer I : I = func F_LASTINDEX(WELEMENTTREE)
  Local Char RESULT(120)

  If WELEMENTTREE(I) <> "" Then
    RESULT = WELEMENTTREE(I)
  Endif

End RESULT


#**
#* Legge una stringa JSON a partire dalla " di apertura (indice PI) gestendo
#* le sequenze di escape \" e \\ e restituisce il contenuto in WVAL.
#* WJ assume la posizione della " di chiusura (o -1 in caso di errore).
#*
#* @param YDOC  - documento JSON
#* @param PIDX    - indice della " di apertura
#* @param WVAL  - contenuto stringa (in uscita)
#* @param WJ    - posizione " di chiusura (in uscita)
#*!
Subprog S_READ_STRING(YDOC, PIDX, WVAL, WJ)
Variable Clbfile YDOC
Variable Integer PIDX
Variable Clbfile WVAL
Variable Integer WJ

  Local Integer J
  Local Clbfile YBUF(1)

  Raz YBUF
  J = PIDX + 1
  While J < len(YDOC)
    If mid$(YDOC,J,1) = "\" Then
      If mid$(YDOC,J+1,1) = '\"' Then
        YBUF += '\"'
        J += 2
      Elsif mid$(YDOC,J+1,1) = "\" Then
        YBUF += "\\"
        J += 2
      Else
        YBUF += "\"
        J += 1
      Endif
    Elsif mid$(YDOC,J,1) = '"' Then
      WJ = J
      WVAL = YBUF
      End
    Else
      YBUF += mid$(YDOC,J,1)
      J += 1
    Endif
  Wend

  WJ = -1

End


#**
#* Emette l'evento END_ELEMENT verso l'handler per l'elemento corrente
#*
#* @param PEVENTHANDLER  - nome del sorgente handler
#* @param PURI           - albero (percorso) corrente
#* @param PELECOUNTER    - contatore occorrenze percorsi
#* @param PELEMENT       - nome dell'elemento
#* @param PVALUE_CLB     - valore estratto (Clbfile)
#* @param PCOUNT         - contatore occorrenze del percorso
#* @param PSTOP          - in/out interruzione analisi
#* @param WERRMSG        - messaggi di errore in uscita
#*!
Subprog EMIT_END(PEVENTHANDLER, PURI, PELECOUNTER, PELEMENT, PVALUE_CLB, PCOUNT, PSTOP, WERRMSG)
Value Char PEVENTHANDLER
Value Char PURI()
Value Char PELECOUNTER()
Value Char PELEMENT
Variable Clbfile PVALUE_CLB
Variable Integer PCOUNT
Variable Integer PSTOP
Variable Char WERRMSG

  # Normalizza il valore (rimuove eventuali spazi e delimitazioni) e lo
  # espone come Char PVALUE visibile all'handler tramite il gosub.
  PVALUE_CLB = vireblc(PVALUE_CLB, 2)
  If left$(PVALUE_CLB, 1) = '"' Then PVALUE_CLB = mid$(PVALUE_CLB, 2, len(PVALUE_CLB)) : Endif
  If right$(PVALUE_CLB, 1) = '"' Then PVALUE_CLB = mid$(PVALUE_CLB, 1, len(PVALUE_CLB) - 1) : Endif

  Local Char PVALUE(254) : PVALUE = PVALUE_CLB

  Raz PCOUNT
  PCOUNT = func F_COUNT_ELEMENT(PURI, PELECOUNTER)

  Local Char YEVENT(20) : YEVENT = "END_ELEMENT"

  Gosub YPARSING From =PEVENTHANDLER

End


#====================================================================
# Gestione dell'albero URI e del contatore occorrenze
#--------------------------------------------------------------------


#**
#* Accoda un elemento alla cima dell'albero e aggiorna il contatore
#*
#* @param WELEMENTTREE   - albero dei nodi
#* @param WELECOUNTER    - contatore occorrenze percorsi
#* @param YCURRELEMENT   - nome elemento da accodare
#* @param WCOUNT         - contatore del percorso (in uscita)
#*!
Subprog APPEND_TO_TREEELEMENT(WELEMENTTREE, WELECOUNTER, YCURRELEMENT, WCOUNT)
Variable Char WELEMENTTREE
Variable Char WELECOUNTER
Value Char YCURRELEMENT
Variable Integer WCOUNT

  Local Integer I : I = -1
  Repeat
    I += 1
  Until vireblc(WELEMENTTREE(I), 4) = ""
  WELEMENTTREE(I) = YCURRELEMENT
  Call UPDATECOUNTER(WELEMENTTREE, WELECOUNTER, WCOUNT)

End


#**
#* Rimuove l'ultimo elemento dall'albero (pop)
#*
#* @param WELEMENTTREE  - albero dei nodi
#*!
Subprog REMOVE_LAST_TREEELEMENT(WELEMENTTREE)
Variable Char WELEMENTTREE

  Local Integer I : I = func F_LASTINDEX(WELEMENTTREE)
  Raz WELEMENTTREE(I)

End


#**
#* Ritorna l'ultimo indice popolato dell'albero (o 0)
#*
#* @param WELEMENTTREE  - albero dei nodi
#*!
Funprog F_LASTINDEX(WELEMENTTREE)
Value Char WELEMENTTREE

  Local Integer I : I = 0
  While WELEMENTTREE(I) <> ""
    I += 1
  Wend
  If I >= 1 Then I -= 1 : Endif

End I


#**
#* Aggiorna il contatore delle occorrenze di ogni percorso
#*
#* @param WELEMENTTREE   - albero dei nodi
#* @param WELECOUNTER    - contatore occorrenze percorsi
#* @param WCOUNT         - contatore del percorso corrente (in uscita)
#*!
Subprog UPDATECOUNTER(WELEMENTTREE, WELECOUNTER, WCOUNT)
Variable Char WELEMENTTREE
Variable Char WELECOUNTER
Variable Integer WCOUNT

  Local Integer I : I = 0
  Local Integer J
  Local Shortint TROVATO : Raz TROVATO

  While WELECOUNTER(I,0) <> ""
    TROVATO = 1
    J = 0
    While WELEMENTTREE(J) <> ""
      If WELEMENTTREE(J) <> WELECOUNTER(I, J) Then
        Raz TROVATO
        Break
      Endif
      J += 1
      If J >= dim(WELEMENTTREE) Then Break : Endif
    Wend
    If TROVATO = 1 Then
      If WELECOUNTER(I, J) = "" Then
        WCOUNT = val(WELECOUNTER(I, func F_DEEPLEVEL())) + 1
        WELECOUNTER(I, func F_DEEPLEVEL()) = num$(WCOUNT)
        End
      Endif
    Endif
    I += 1
  Wend

  If TROVATO <> 1 Then
    J = 0
    While WELEMENTTREE(J) <> ""
      WELECOUNTER(I, J) = WELEMENTTREE(J)
      J += 1
    Wend
    WCOUNT = 1
    WELECOUNTER(I, func F_DEEPLEVEL()) = num$(WCOUNT)
  Endif

End


#**
#* Ritorna il contatore delle occorrenze del percorso corrente
#*
#* @param WELEMENTTREE   - albero dei nodi
#* @param WELECOUNTER    - contatore occorrenze percorsi
#*!
Funprog F_COUNT_ELEMENT(WELEMENTTREE, WELECOUNTER)
Variable Char WELEMENTTREE
Variable Char WELECOUNTER

  Local Integer I : I = 0
  Local Integer J
  Local Integer RESULT : RESULT = 0
  Local Shortint TROVATO : Raz TROVATO

  Repeat
    TROVATO = 1
    J = 0
    While WELEMENTTREE(J) <> ""
      If WELEMENTTREE(J) <> WELECOUNTER(I, J) Then
        Raz TROVATO
        Break
      Endif
      J += 1
      If J >= dim(WELEMENTTREE) Then Break : Endif
    Wend
    If TROVATO = 1 Then
      If WELECOUNTER(I, J) = "" Then
        RESULT = val(WELECOUNTER(I, func F_DEEPLEVEL()))
      Endif
    Endif
    I += 1
  Until WELECOUNTER(I,0) = "" | RESULT > 0

End RESULT


#**
#* Unisce gli elementi di un array in una stringa con separatore
#*
#* @param PARRAY  - array di stringhe da unire
#* @param PSTR    - separatore
#*!
Funprog JOIN_ARRAY(PARRAY, PSTR)
Value Char PARRAY()
Value Char PSTR

  Local Char YRESULT(250) : YRESULT = ""
  Local Integer I
  While I <= dim(PARRAY) and PARRAY(I) <> ""
    If YRESULT <> "" Then YRESULT += PSTR : Endif
    YRESULT += PARRAY(I)
    I += 1
  Wend

End YRESULT

